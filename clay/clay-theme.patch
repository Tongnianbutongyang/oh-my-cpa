diff --git a/web/src/theme/clay.css b/web/src/theme/clay.css
new file mode 100644
index 0000000..c9949b7
--- /dev/null
+++ b/web/src/theme/clay.css
@@ -0,0 +1,107 @@
+/* ── Clay theme ─────────────────────────────────────────────────────────────
+   Soft pastel claymorphism. Everything is scoped to the Clay palette, so the official
+   built-in palettes are untouched. Selectable in Settings → Appearance. */
+
+html[data-theme='clay'] {
+  --clay-pink: #f2b4c9;
+  --clay-lavender: #c9bdf8;
+  --clay-mint: #9ee0d2;
+  --clay-peach: #f7c8a4;
+  --clay-periwinkle: #b4c7f5;
+  /* Puffier corners than the shipped scale; components still name --radius-* steps. */
+  --radius-xs: 6px;
+  --radius-sm: 10px;
+  --radius-md: 14px;
+  --radius-lg: 18px;
+  --radius-xl: 24px;
+  --font-ui: "Nunito", "Varela Round", "M PLUS Rounded 1c", "HarmonyOS Sans SC", "PingFang SC", "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans CJK SC", "Noto Sans SC", system-ui, sans-serif;
+  /* Purple-tinted clay drops, keeping the official shadow token names so every surface follows. */
+  --edge-drop:
+    inset 0 2px 0 rgba(255, 255, 255, 0.92),
+    inset 0 -4px 8px rgba(120, 90, 150, 0.10),
+    0 16px 32px -12px rgba(90, 72, 130, 0.36),
+    0 4px 10px rgba(90, 72, 130, 0.12);
+  --raised-drop:
+    inset 0 2px 0 rgba(255, 255, 255, 0.95),
+    inset 0 -4px 10px rgba(120, 90, 150, 0.12),
+    0 18px 36px -12px rgba(90, 72, 130, 0.40),
+    0 6px 14px rgba(90, 72, 130, 0.14);
+  --float-drop:
+    inset 0 2px 0 rgba(255, 255, 255, 0.95),
+    0 8px 20px rgba(90, 72, 130, 0.28),
+    0 22px 44px -12px rgba(90, 72, 130, 0.42);
+  --overlay-drop:
+    inset 0 2px 0 rgba(255, 255, 255, 0.95),
+    0 12px 28px rgba(90, 72, 130, 0.30),
+    0 32px 64px -16px rgba(90, 72, 130, 0.48);
+  --control-drop:
+    inset 0 2px 0 rgba(255, 255, 255, 0.95),
+    inset 0 -3px 6px rgba(90, 70, 150, 0.14),
+    0 8px 16px -8px rgba(90, 70, 140, 0.34),
+    0 3px 6px rgba(90, 70, 140, 0.12);
+  --well-drop: inset 0 3px 6px rgba(90, 70, 130, 0.18), inset 0 -1px 0 rgba(255, 255, 255, 0.65);
+  --shadow-primary:
+    inset 0 2px 0 rgba(255, 255, 255, 0.35),
+    inset 0 -2px 6px rgba(40, 30, 90, 0.18),
+    0 8px 16px -6px rgba(123, 111, 214, 0.55);
+  --primary-sheen: linear-gradient(to bottom, rgb(255 255 255 / 0.28), transparent 42%);
+  background: var(--bg);
+}
+
+html[data-theme='clay'] body {
+  font-family: var(--font-ui);
+  background:
+    radial-gradient(900px 500px at 100% -10%, rgba(217, 208, 251, 0.35), transparent 60%),
+    radial-gradient(700px 420px at -10% 110%, rgba(253, 217, 189, 0.30), transparent 60%),
+    var(--bg);
+  background-attachment: fixed;
+}
+
+html[data-theme='clay'] .app-shell {
+  background:
+    radial-gradient(900px 500px at 100% -10%, rgba(217, 208, 251, 0.35), transparent 60%),
+    radial-gradient(700px 420px at -10% 110%, rgba(253, 217, 189, 0.30), transparent 60%),
+    var(--canvas);
+}
+
+/* Raised clay tiles and preset cards keep official radius tokens, but take a macaron wash. */
+html[data-theme='clay'] .dashboard-tile {
+  position: relative;
+  overflow: hidden;
+  background: var(--surface);
+}
+
+html[data-theme='clay'] .dashboard-tile::before {
+  content: "";
+  position: absolute;
+  inset: 0 0 auto 0;
+  height: 100%;
+  pointer-events: none;
+  background: linear-gradient(160deg, var(--tile-tint, var(--clay-lavender)) 0%, transparent 55%);
+  opacity: 0.55;
+}
+
+html[data-theme='clay'] .dashboard-tile > * { position: relative; }
+
+html[data-theme='clay'] .dashboard-cell:nth-child(5n+1) > .dashboard-tile { --tile-tint: var(--clay-lavender); }
+html[data-theme='clay'] .dashboard-cell:nth-child(5n+2) > .dashboard-tile { --tile-tint: var(--clay-pink); }
+html[data-theme='clay'] .dashboard-cell:nth-child(5n+3) > .dashboard-tile { --tile-tint: var(--clay-mint); }
+html[data-theme='clay'] .dashboard-cell:nth-child(5n+4) > .dashboard-tile { --tile-tint: var(--clay-peach); }
+html[data-theme='clay'] .dashboard-cell:nth-child(5n+5) > .dashboard-tile { --tile-tint: var(--clay-periwinkle); }
+
+html[data-theme='clay'] .app-brand {
+  color: #5344b8;
+}
+
+/* Capsule navigation and primary actions. 9999px is on the official corner scale (full). */
+html[data-theme='clay'] .app-menu-item,
+html[data-theme='clay'] .app-menu-highlight,
+html[data-theme='clay'] .app-menu-item:focus-visible {
+  border-radius: 9999px;
+}
+
+html[data-theme='clay'] [data-slot='button'][data-variant='primary'],
+html[data-theme='clay'] [data-slot='button'][data-variant='destructive'],
+html[data-theme='clay'] .tag {
+  border-radius: 9999px;
+}
diff --git a/web/src/theme/clayTheme.ts b/web/src/theme/clayTheme.ts
new file mode 100644
index 0000000..387cfae
--- /dev/null
+++ b/web/src/theme/clayTheme.ts
@@ -0,0 +1,43 @@
+import { registerTheme } from './palette';
+import type { OMCThemeManifest } from './themeContract';
+
+/**
+ * Clay (软陶): a cream, macaron-pastel theme registered through the official Theme SDK.
+ *
+ * It is an external/optional palette, not a built-in, so the six shipped palettes stay
+ * untouched. The puffy claymorphism layer lives in `clay.css`, scoped to `[data-theme='clay']`.
+ */
+export const CLAY_THEME_MANIFEST: OMCThemeManifest = {
+  schemaVersion: 1,
+  id: 'clay',
+  mode: 'light',
+  label: 'Clay',
+  description: 'Cream surfaces, macaron pastels and soft puffy cards',
+  author: 'Tongnianbutongyang',
+  version: '0.4.9',
+  core: {
+    bg: '#f7f1ea',
+    surface: '#fffaf5',
+    elevated: '#fffdfa',
+    fg: '#322a44',
+    fg2: '#524a66',
+    muted: '#6a6280',
+    meta: '#8a829c',
+    border: '#ece2d8',
+    accent: '#5546bc',
+  },
+  overrides: {
+    primary: '#5546bc',
+    success: '#3fae8f',
+    warn: '#e0954a',
+    danger: '#e06c8a',
+    // Macaron hues, deepened just enough to clear graphical-object contrast on the card.
+    series: ['#8f7ef0', '#ed5988', '#349c8c', '#e36a0c', '#528bf0', '#d562c8'],
+  },
+};
+
+export function registerClayTheme(): () => void {
+  return registerTheme(CLAY_THEME_MANIFEST);
+}
+
+registerClayTheme();
