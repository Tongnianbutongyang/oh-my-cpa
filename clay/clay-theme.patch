new file mode 100644
index 0000000..c9d29a1
--- /dev/null
+++ b/web/src/theme/clay.css
@@ -0,0 +1,115 @@
+/* ── Clay theme ─────────────────────────────────────────────────────────────
+   Soft pastel claymorphism. Everything is scoped to the Clay palette, so the other
+   built-in palettes are untouched. Selectable in Settings → Appearance. */
+html[data-theme='clay'] {
+  --clay-pink: #f7c6d6;
+  --clay-lavender: #d9d0fb;
+  --clay-mint: #bfeee3;
+  --clay-peach: #fdd9bd;
+  --clay-periwinkle: #c9d8fb;
+  --clay-shadow: 0 14px 30px -12px rgba(122, 104, 160, .30), 0 3px 8px rgba(122, 104, 160, .08);
+  --clay-shadow-sm: 0 6px 14px -6px rgba(122, 104, 160, .28);
+  --clay-inner: inset 0 2px 0 rgba(255, 255, 255, .85), inset 0 -3px 6px rgba(150, 120, 170, .06);
+  --font-ui: "Nunito", "Varela Round", "M PLUS Rounded 1c", "HarmonyOS Sans SC", "PingFang SC", "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans CJK SC", "Noto Sans SC", system-ui, sans-serif !important;
+  --radius-xs: 6px;
+  --radius-sm: 12px;
+  --radius-document: 14px;
+  --radius-control: 14px;
+  --radius-surface: 22px;
+  --radius-thread: 22px;
+  background: var(--bg);
+}
+html[data-theme='clay'] body {
+  font-family: var(--font-ui);
+  background:
+    radial-gradient(900px 500px at 100% -10%, rgba(217, 208, 251, .35), transparent 60%),
+    radial-gradient(700px 420px at -10% 110%, rgba(253, 217, 189, .30), transparent 60%),
+    var(--bg);
+  background-attachment: fixed;
+}
+html[data-theme='clay'] .ant-layout,
+html[data-theme='clay'] .ant-layout-content,
+html[data-theme='clay'] .ant-layout-header { background: transparent !important; }
+
+/* Raised clay tiles */
+html[data-theme='clay'] .ant-card,
+html[data-theme='clay'] .dashboard-tile,
+html[data-theme='clay'] .ant-table-wrapper .ant-table,
+html[data-theme='clay'] .theme-preset-card {
+  border: 1px solid rgba(255, 255, 255, .7) !important;
+  border-radius: 26px !important;
+  background: var(--surface) !important;
+  box-shadow: var(--clay-shadow), var(--clay-inner) !important;
+}
+html[data-theme='clay'] .ant-table-wrapper .ant-table-container { border-radius: 26px; overflow: hidden; }
+html[data-theme='clay'] .ant-table-wrapper .ant-table-thead > tr > th { background: #fbf4ec !important; border-bottom-color: var(--border) !important; }
+
+/* Pastel tint per dashboard tile, cycling the macaron set */
+html[data-theme='clay'] .dashboard-tile { position: relative; overflow: hidden; }
+html[data-theme='clay'] .dashboard-tile::before {
+  content: ""; position: absolute; inset: 0 0 auto 0; height: 100%; pointer-events: none;
+  background: linear-gradient(160deg, var(--tile-tint, var(--clay-lavender)) 0%, transparent 55%); opacity: .55;
+}
+html[data-theme='clay'] .dashboard-tile > * { position: relative; }
+html[data-theme='clay'] .dashboard-cell:nth-child(5n+1) > .dashboard-tile { --tile-tint: var(--clay-lavender); }
+html[data-theme='clay'] .dashboard-cell:nth-child(5n+2) > .dashboard-tile { --tile-tint: var(--clay-pink); }
+html[data-theme='clay'] .dashboard-cell:nth-child(5n+3) > .dashboard-tile { --tile-tint: var(--clay-mint); }
+html[data-theme='clay'] .dashboard-cell:nth-child(5n+4) > .dashboard-tile { --tile-tint: var(--clay-peach); }
+html[data-theme='clay'] .dashboard-cell:nth-child(5n+5) > .dashboard-tile { --tile-tint: var(--clay-periwinkle); }
+
+/* Sidebar: floating soft panel, pill navigation */
+html[data-theme='clay'] .app-sider {
+  background: transparent !important;
+}
+html[data-theme='clay'] .app-sider .ant-layout-sider-children {
+  margin: 12px 0 12px 12px; height: calc(100% - 24px);
+  border-radius: 28px; background: var(--surface);
+  box-shadow: var(--clay-shadow), var(--clay-inner);
+}
+html[data-theme='clay'] .app-menu .ant-menu-item::after, html[data-theme='clay'] .app-menu .ant-menu-item::before { display: none !important; }
+html[data-theme='clay'] .app-menu .ant-menu-item-selected { border-left: 0 !important; }
+html[data-theme='clay'] .app-menu .ant-menu-item { border-radius: 999px !important; font-weight: 600; }
+html[data-theme='clay'] .app-menu .ant-menu-item-selected {
+  background: linear-gradient(135deg, #e9e2ff, #fbe1ec) !important; color: #4f43b3 !important;
+  box-shadow: var(--clay-shadow-sm), inset 0 1px 0 rgba(255,255,255,.9) !important;
+  border-radius: 999px !important;
+}
+html[data-theme='clay'] .app-menu .ant-menu-item-selected:hover { background: linear-gradient(135deg, #e3dbff, #f9d6e4) !important; }
+
+/* Pills */
+html[data-theme='clay'] .ant-btn { border-radius: 999px !important; font-weight: 700; }
+html[data-theme='clay'] .ant-btn-primary { background: linear-gradient(135deg, #8f82ea, #b39cf0) !important; border: 0 !important; box-shadow: 0 8px 16px -8px rgba(123,111,214,.7), inset 0 1px 0 rgba(255,255,255,.35) !important; }
+html[data-theme='clay'] .ant-btn-default { background: #fffaf5 !important; box-shadow: var(--clay-shadow-sm), var(--clay-inner) !important; }
+html[data-theme='clay'] .ant-tag, html[data-theme='clay'] .tag, html[data-theme='clay'] .status-label {
+  border-radius: 999px !important; padding-inline: 10px;
+}
+html[data-theme='clay'] .ant-segmented { border-radius: 999px; padding: 3px; box-shadow: inset 0 2px 5px rgba(120,100,150,.10); }
+html[data-theme='clay'] .ant-segmented-item, html[data-theme='clay'] .ant-segmented-thumb { border-radius: 999px !important; }
+html[data-theme='clay'] .ant-segmented-item-selected { box-shadow: var(--clay-shadow-sm) !important; }
+
+/* Soft inputs */
+html[data-theme='clay'] .ant-input, html[data-theme='clay'] .ant-input-affix-wrapper,
+html[data-theme='clay'] .ant-select-selector, html[data-theme='clay'] .ant-input-number,
+html[data-theme='clay'] .ant-picker, html[data-theme='clay'] .ant-select {
+  border-radius: 14px !important; background: #fffdfa !important;
+  box-shadow: inset 0 2px 5px rgba(120, 100, 150, .08);
+}
+html[data-theme='clay'] .ant-switch { box-shadow: inset 0 2px 4px rgba(0,0,0,.08); }
+html[data-theme='clay'] .ant-switch.ant-switch-checked, html[data-theme='clay'] .ant-switch.ant-switch-checked:hover:not(.ant-switch-disabled) { background: linear-gradient(135deg, #8f82ea, #f49cb8) !important; }
+
+/* Capsule meters / progress */
+html[data-theme='clay'] .meter, html[data-theme='clay'] .progress-bar { height: 8px; border-radius: 999px; background: #efe6f6; }
+html[data-theme='clay'] .meter > *, html[data-theme='clay'] .progress-bar > * { border-radius: 999px; }
+html[data-theme='clay'] .legend-dot { border-radius: 999px !important; }
+
+/* Floating layers */
+html[data-theme='clay'] .ant-modal-content, html[data-theme='clay'] .ant-drawer-content,
+html[data-theme='clay'] .ant-dropdown-menu, html[data-theme='clay'] .ant-popover-inner,
+html[data-theme='clay'] .ant-select-dropdown, html[data-theme='clay'] .ant-notification-notice {
+  border-radius: 22px !important; box-shadow: var(--clay-shadow) !important;
+}
+html[data-theme='clay'] *::-webkit-scrollbar-thumb { background: #e2d6ea; border-radius: 999px; }
+html[data-theme='clay'] .app-menu .ant-menu-item { margin-inline: 12px !important; width: calc(100% - 24px) !important; }
+/* Console's own toggle (CSS-module switch) */
+html[data-theme='clay'] [role='switch'][class*='is-checked'] { background: linear-gradient(135deg, #8f82ea, #f49cb8) !important; border-color: transparent !important; }
+html[data-theme='clay'] [role='switch'] { border-radius: 999px !important; --success: #9b8cf2; }
diff --git a/web/src/theme/clayTheme.ts b/web/src/theme/clayTheme.ts
new file mode 100644
index 0000000..f5ceb1d
--- /dev/null
+++ b/web/src/theme/clayTheme.ts
@@ -0,0 +1,51 @@
+import type { ThemeConfig } from 'antd';
+import type { ThemePalette } from './palette';
+
+/**
+ * Clay: a soft pastel "claymorphism" layer over the base Ant Design config.
+ *
+ * Kept as a pure overlay so upstream changes to `createThemeConfig` flow through untouched; the
+ * page-level look (puffy shadows, capsule shapes) lives in `clay.css`, scoped to
+ * `[data-theme='clay']`.
+ */
+const CLAY_SHADOW = '0 10px 24px -8px rgba(122, 104, 160, 0.28), 0 2px 6px rgba(122, 104, 160, 0.10)';
+
+export function applyClayTheme(base: ThemeConfig, t: ThemePalette): ThemeConfig {
+  const comp = base.components ?? {};
+  const pill = { borderRadius: 999, borderRadiusLG: 999, borderRadiusSM: 999 };
+  return {
+    ...base,
+    token: {
+      ...base.token,
+      fontFamily: 'var(--font-ui)',
+      borderRadius: 14,
+      borderRadiusLG: 22,
+      borderRadiusSM: 10,
+      borderRadiusXS: 6,
+      colorSuccess: '#3fae8f',
+      colorWarning: '#e0954a',
+      colorError: '#e06c8a',
+      boxShadow: CLAY_SHADOW,
+      boxShadowSecondary: CLAY_SHADOW,
+      boxShadowTertiary: CLAY_SHADOW,
+    },
+    components: {
+      ...comp,
+      Button: { ...comp.Button, ...pill, controlHeight: 34, primaryShadow: '0 6px 14px -6px rgba(123,111,214,0.6)', defaultShadow: 'none' },
+      Input: { ...comp.Input, borderRadius: 14, activeShadow: `0 0 0 3px ${t.accent}26` },
+      InputNumber: { ...comp.InputNumber, borderRadius: 14 },
+      Select: { ...comp.Select, borderRadius: 14, optionSelectedBg: '#efeafd' },
+      Tag: { ...comp.Tag, borderRadiusSM: 999, defaultBg: '#f3eefb' },
+      Segmented: { ...comp.Segmented, ...pill, itemSelectedBg: '#ffffff', trackBg: '#f1e9e1' },
+      Card: { ...comp.Card, borderRadiusLG: 24 },
+      Modal: { ...comp.Modal, borderRadiusLG: 26, boxShadow: CLAY_SHADOW },
+      Drawer: { ...comp.Drawer },
+      Popover: { ...comp.Popover, borderRadiusLG: 18, boxShadowSecondary: CLAY_SHADOW },
+      Dropdown: { ...comp.Dropdown, borderRadiusLG: 18, boxShadowSecondary: CLAY_SHADOW },
+      Menu: { ...comp.Menu, itemBorderRadius: 999, itemSelectedBg: '#ece6fd', itemSelectedColor: '#5b4fc0' },
+      Table: { ...comp.Table, borderRadiusLG: 20, headerBg: '#fbf5ee' },
+      Switch: { ...comp.Switch, colorPrimary: '#9b8cf2', colorPrimaryHover: '#8f82ea' },
+      Notification: { ...comp.Notification, borderRadiusLG: 20 },
+    },
+  };
+}
